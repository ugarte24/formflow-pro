# Configuración del PC del operador — SIN token secreto.
# El administrador activa/desactiva operadores y PCs desde la web (Admin).

# URL de Digitalizador (Vercel)
BASE_URL=https://formflow-pro-sigma.vercel.app

# Código fijo del PC (no hace falta registrarlo en Admin)
CODIGO_PC=PC-DEFAULT

# Segundos entre consultas
POLL_SECONDS=4

DOWNLOAD_DIR=%USERPROFILE%\DigitalizadorAgent\downloads

FIREFOX_MODE=persistent
FIREFOX_PROFILE_DIR=%USERPROFILE%\DigitalizadorAgent\firefox-profile
FIREFOX_CDP_URL=http://127.0.0.1:9222
RUAT_START_URL=http://municipios.ruat.net/ContribuyentesWeb/Administracion/menuPrincipal/MenuPrincipalController.jpf

DRY_RUN=0

# Fase 2: 1 = el agente también pulsa Grabar
GRABAR_AUTOMATICO=0
