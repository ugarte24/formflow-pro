# Copiar a .env y completar.
# BASE_URL = URL pública de la app (Vercel o local).
# AGENT_TOKEN = token del PC (Admin → Computadores → ver token).

BASE_URL=https://formflow-pro-sigma.vercel.app
AGENT_TOKEN=

# Segundos entre consultas a /api/public/agente/pendientes
POLL_SECONDS=4

# Carpeta para fotos descargadas antes de subirlas a RUAT
DOWNLOAD_DIR=%USERPROFILE%\DigitalizadorAgent\downloads

# Firefox:
#   persistent  = perfil dedicado (recomendado; inicie sesión RUAT una vez)
#   connect_cdp = adjunta a Firefox ya abierto (start-firefox-ruat.ps1)
#   launch      = Firefox limpio (solo pruebas)
FIREFOX_MODE=persistent
FIREFOX_PROFILE_DIR=%USERPROFILE%\DigitalizadorAgent\firefox-profile
# Solo para connect_cdp:
FIREFOX_CDP_URL=http://127.0.0.1:9222

# URL del menú principal Contribuyentes (Riberalta / municipios.ruat.net)
RUAT_START_URL=http://municipios.ruat.net/ContribuyentesWeb/Administracion/menuPrincipal/MenuPrincipalController.jpf

# 1 = el agente también pulsa Grabar tras Imprimir Reporte (Fase 2)
# 0 = modo seguro MVP: el operador revisa el reporte y graba a mano
GRABAR_AUTOMATICO=0
