# Copiar a .env y completar valores reales.
# Este archivo SÍ puede ir a git; .env NO.
# Stack: Vercel + Supabase (+ Gemini para OCR). Sin Lovable Cloud.

# Supabase (cliente + SSR)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Solo servidor (API agente, admin). NUNCA prefijo VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Mismas vars con prefijo VITE_ para el cliente Vite
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# OCR con Google Gemini (solo servidor / Vercel)
# Crear clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-flash-latest

# En Supabase Dashboard → Authentication → Providers → Email:
# desactivar "Enable sign ups" (las cuentas las crea el admin).
