# Copiar a .env y completar valores reales.
# Este archivo SÍ puede ir a git; .env NO.

# Supabase (cliente + SSR)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Mismas vars con prefijo VITE_ para el cliente Vite
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (API agente, admin). NUNCA prefijo VITE_
SUPABASE_SERVICE_ROLE_KEY=

# OCR / Lovable AI Gateway (solo servidor)
LOVABLE_API_KEY=
